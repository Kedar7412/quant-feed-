# Quant Feed backend environment. Copy to `.env` and fill in secrets.
# Localhost defaults below match docker-compose.yml so dev/tests work without a .env.

# --- Neo4j graph store ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=quantfeed_dev

# --- Qdrant vector store ---
QDRANT_URL=http://localhost:6333
# Optional; leave blank for the local (unauthenticated) dev instance.
QDRANT_API_KEY=

# --- Postgres system-of-record ---
DATABASE_URL=postgresql+psycopg://quantfeed:quantfeed_dev@localhost:5432/quantfeed

# --- Redis (Celery broker/result backend + real-time diff pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- Step 2 real-time WebSocket graph diffs ---
# OFF by default: nothing publishes and the /ws/graph gateway simply fans out
# nothing until this is enabled. When True, run_ingestion best-effort publishes
# a graph diff to DIFF_CHANNEL after persistence (a disabled/unreachable Redis
# stays a no-op and never fails ingestion). See backend/README.md "Step 2".
REALTIME_ENABLED=false
# Redis pub/sub channel carrying serialized graph diffs.
DIFF_CHANNEL=quantfeed:graph-diffs

# --- OpenAI (embeddings + causal classifier; used in FEAT-002) ---
# Provide a real key via the environment only. Never commit it.
OPENAI_API_KEY=

# --- Pipeline tunables ---
SPACY_MODEL=en_core_web_sm
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# --- Relationship scoring weights (composite RELATES_TO weight) ---
WEIGHT_SEMANTIC=0.35
WEIGHT_ENTITY_OVERLAP=0.25
WEIGHT_CAUSAL=0.40

# --- CORS: the Next.js frontend origin ---
FRONTEND_ORIGIN=http://localhost:3000
