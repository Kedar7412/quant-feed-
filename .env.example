# OpenAI API Key for AI summarization and analysis
# Leave empty to use mock data fallback
OPENAI_API_KEY=

# Cron job secret for Vercel
CRON_SECRET=

# GNews API Key (optional, free tier: 100 requests/day)
# Sign up at https://gnews.io to get a free API key
# If not set, the GNews fetcher will simply return no results
GNEWS_API_KEY=

# NewsData.io API Key (optional, free tier: 200 requests/day)
# Sign up at https://newsdata.io to get a free API key
# If not set, the NewsData fetcher will simply return no results
NEWSDATA_API_KEY=

# The Guardian Open Platform API Key (free, open-source tier)
# Register at https://open-platform.theguardian.com/access/
# If not set, the Guardian fetcher will simply return no results
GUARDIAN_API_KEY=

# --- Step 1 graph/vector backbone (optional) -------------------------------
# The ONLY variable the Next.js frontend needs to talk to the FastAPI backend.
# Base URL of the deployed backend (e.g. https://quant-feed-backend.up.railway.app).
# Leave UNSET to use the built-in live-fetch behavior (default). When set,
# /api/graph proxies to {BACKEND_URL}/graph/query and falls back gracefully if
# the backend is unreachable. See backend/README.md.
BACKEND_URL=

# The variables below are consumed by the Python backend (backend/), NOT by the
# Next.js app. They are listed here for a single reference point; the backend
# reads them from its own backend/.env. See backend/README.md for details.

# Neo4j graph store (local dev default: bolt://localhost:7687).
# Neo4j Aura form: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Qdrant vector store. Local dev: http://localhost:6333 (no key).
# Qdrant Cloud: https://<cluster>.<region>.aws.cloud.qdrant.io:6333 + API key.
QDRANT_URL=
QDRANT_API_KEY=

# Postgres system-of-record (SQLAlchemy URL).
# Local dev: postgresql+psycopg://quantfeed:quantfeed_dev@localhost:5432/quantfeed
DATABASE_URL=
