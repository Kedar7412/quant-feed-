# OpenAI API Key for AI summarization and analysis
# Leave empty to use mock data fallback
OPENAI_API_KEY=

# Cron job secret for Vercel
CRON_SECRET=

# GNews API Key (optional, free tier: 100 requests/day)
# Sign up at https://gnews.io to get a free API key
# If not set, the GNews fetcher will simply return no results
GNEWS_API_KEY=

# NewsData.io API Key (optional, free tier: 200 requests/day)
# Sign up at https://newsdata.io to get a free API key
# If not set, the NewsData fetcher will simply return no results
NEWSDATA_API_KEY=
